{
  "name": "apps-yaronogen",
  "version": "0.1.0",
  "private": true,
  "description": "Apps by Yaron Ogen: static website for apps.yaronogen.com (Tally first).",
  "type": "module",
  "engines": {
    "node": ">=20.9"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build && node scripts/postbuild.mjs",
    "start": "node scripts/serve.mjs 3000",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "check": "npm run typecheck && npm run lint && npm run test && npm run build && npm run test:e2e",
    "sync:tally": "tsx scripts/sync-tally.ts",
    "legal:check": "tsx scripts/sync-tally.ts --check",
    "og": "tsx scripts/og-images.ts",
    "screenshots": "tsx scripts/screenshots.ts"
  },
  "dependencies": {
    "lucide-react": "1.63.0",
    "next": "16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.19.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.4",
    "eslint-config-next": "16.4.3",
    "playwright-core": "1.64.1",
    "sharp": "0.35.5",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "4.1.12"
  }
}
